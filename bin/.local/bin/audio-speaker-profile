#!/bin/bash
# Ativa o perfil com Speaker (o automático só expõe "Headphones")
CARD=alsa_card.pci-0000_00_1f.3-platform-skl_hda_dsp_generic
PROFILE='HiFi (HDMI1, HDMI2, HDMI3, Mic1, Mic2, Speaker)'
for i in $(seq 1 20); do
  if pactl list cards short 2>/dev/null | grep -q "$CARD"; then
    pactl set-card-profile "$CARD" "$PROFILE" && exit 0
  fi
  sleep 0.5
done
exit 1

{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "notifications": {
    "rules": [
      {
        "app": "Brave",
        "body~": "teams\\.cloud\\.microsoft",
        "urgency": "critical",
        "set": {
          "urgency": "normal"
        }
      }
    ]
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "tiago.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "tiago.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "tiago.screen-recording"
        },
        {
          "id": "omarchy.microphone"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power",
          "showPercentage": true
        },
        {
          "id": "omarchy.tray"
        }
      ]
    }
  },
  "plugins": [
    {
      "id": "tiago.notifications"
    }
  ],
  "disabledPlugins": [
    "omarchy.notifications"
  ],
  "cloneSourceRestores": [
    "tiago.notifications"
  ]
}

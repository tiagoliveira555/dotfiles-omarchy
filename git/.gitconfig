[user]
	email = tiagoliveira555@gmail.com
	name = Tiago Oliveira
[core]
	editor = code --wait
	pager = cat
[push]
	followTags = true
	autoSetupRemote = true
	default = current
[alias]
	s = !git status -s
	c = !git add --all && git commit -m
	l = !git log --pretty=format:'%C(blue)%n%C(red)%d %C(white)%s %C(cyan)[%cn] %C(green)%cr'
  t = !sh -c 'git tag -a $1 -m $1' -
	amend = !git add . && git commit --amend --no-edit
[pull]
	default = current
	rebase = false
[rebase]
	autoStash = true

